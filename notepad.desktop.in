[Desktop Entry]
Type=Application
Version=1.0
Name=Notepad
GenericName=Text Editor
Comment=Create and edit plain text documents
Exec="@BIN@" %f
TryExec=@BIN@
Icon=notepad
Terminal=false
Categories=Utility;TextEditor;
Keywords=text;editor;plain;write;
MimeType=text/plain;
StartupNotify=true
StartupWMClass=notepad
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec="@BIN@"
